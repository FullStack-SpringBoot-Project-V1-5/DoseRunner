<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared by all DoseRunner services (lives in the commons jar).
  - profile "prod" (docker-compose, k8s): one JSON object per line (logstash-logback-encoder),
    every MDC key (traceId, orderId, ...) becomes a JSON field.
  - any other profile (dev, tests): readable text with the traceId in brackets.
-->
<configuration>
    <springProperty name="SERVICE" source="spring.application.name" defaultValue="doserunner"/>

    <springProfile name="prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"${SERVICE}"}</customFields>
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <maxDepthPerThrowable>30</maxDepthPerThrowable>
                    <rootCauseFirst>true</rootCauseFirst>
                </throwableConverter>
            </encoder>
        </appender>
    </springProfile>

    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [${SERVICE},%X{traceId:-}] %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>

    <logger name="tn.rnu.eniso.doserunner" level="DEBUG"/>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
