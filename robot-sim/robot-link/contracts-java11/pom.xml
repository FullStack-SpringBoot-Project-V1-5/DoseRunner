<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion><parent><groupId>tn.rnu.eniso.doserunner</groupId><artifactId>robot-link-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>robot-contracts-java11</artifactId>
  <dependencies><dependency><groupId>org.apache.avro</groupId><artifactId>avro</artifactId></dependency></dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><executions><execution>
      <id>reuse-frozen-java-conventions</id><phase>generate-sources</phase><goals><goal>copy-resources</goal></goals><configuration>
        <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
        <resources><resource><directory>${project.basedir}/../../../contracts/src/main/java</directory><filtering>false</filtering><includes>
          <include>**/AvroTrust.java</include><include>**/messaging/Addresses.java</include><include>**/messaging/MessageHeaders.java</include>
        </includes></resource></resources>
      </configuration></execution></executions></plugin>
    <plugin><groupId>org.apache.avro</groupId><artifactId>avro-maven-plugin</artifactId><executions><execution>
      <phase>generate-sources</phase><goals><goal>schema</goal></goals><configuration>
        <sourceDirectory>${project.basedir}/../../../contracts/src/main/avro/robot</sourceDirectory>
        <imports><import>${project.basedir}/../../../contracts/src/main/avro/common/GridPoint.avsc</import></imports>
        <stringType>String</stringType><enableDecimalLogicalType>true</enableDecimalLogicalType>
      </configuration></execution></executions></plugin>
  </plugins></build>
</project>
